{
  "minimumReleaseAge": null,
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard", "helpers:pinGitHubActionDigests"],
  "baseBranchPatterns": [
    "main"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "mode": "full",
  "commitMessageLowerCase": "auto",
  "semanticCommits": "enabled",
  "semanticCommitType": "feat",
  "ignorePaths": ["docs"],
  "labels": ["renovate"],
  "flux": {
    "managerFilePatterns": [
      "/^.*flux\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions", "flux"],
      "groupName": "all-ci-updates",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["sigstore/cosign-installer"],
      "enabled": false
    },
    {
      "description": "grc.store requires the trusted publisher's v1 tag in its OIDC identity",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["revanite-io/pvtr-publish-results"],
      "pinDigests": false,
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions",
        "flux",
        "gomod",
        "dockerfile",
        "docker-compose",
        "custom.regex"
      ],
      "minimumReleaseAge": "14 days"
    },
    {
      "matchManagers": ["helmv3","helm-values"],
      "minimumReleaseAge": null
    },
    {
      "description": "MicroShift: each tracked version line only receives updates from its own minor",
      "matchDepTypes": ["microshift-4.21"],
      "allowedVersions": "/^4\\.21\\./"
    },
    {
      "matchDepTypes": ["microshift-4.22"],
      "allowedVersions": "/^4\\.22\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "MICROSHIFT_TAG_(?<minor>\\d+\\.\\d+)\\s*:=\\s*(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "microshift-io/microshift",
      "depTypeTemplate": "microshift-{{{minor}}}",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "fileMatch": ["^Makefile$"],
      "matchStrings": [
        "(?<depName>[A-Z0-9_]+)_VERSION\\s*[:=?]+\\s*\"?(?<currentValue>[^\"\\r\\n]+)\"?[\\r\\n]+\\s*(?<depName2>[A-Z0-9_]+)_LOOKUP\\s*[:=?]+\\s*\"?(?<lookupValue>[^\"\\r\\n]+)\"?(?:[\\r\\n]+\\s*(?<depName3>[A-Z0-9_]+)_RENOVATE\\s*[:=?]+\\s*\"?(?<renovateValue>[^\"\\r\\n]+)\"?)?(?:[\\r\\n]+\\s*(?<depName4>[A-Z0-9_]+)_SOURCE\\s*[:=?]+\\s*\"?(?<sourceValue>[^\"\\r\\n]+)\"?)?"
      ],
      "depNameTemplate": "{{lookupValue}}",
      "datasourceTemplate": "{{#if sourceValue}}{{sourceValue}}{{else}}github-tags{{/if}}",
      "packageNameTemplate": "{{#if renovateValue}}{{renovateValue}}{{else}}{{lookupValue}}{{/if}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/.*\\.pre-commit-config\\.ya?ml$/"
      ],
      "matchStrings": [
        "repo:\\s*https://github\\.com/(?<lookupValue>[^/]+/[^\\s]+)[\\s\\S]*?rev:\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "{{lookupValue}}",
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{lookupValue}}",
      "versioningTemplate": "semver"
    }
  ]
}
